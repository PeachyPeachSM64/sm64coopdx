#define ASSET_TO_ID(asset, modelId) { \
    if (asset && !assetToIdMap.count((const void *) asset)) { \
        assetToIdMap[(const void *) asset] = modelId; \
    } \
}

#define MODEL_EXTENDED_FROM_GEO(modelId, vanillaId, asset) { \
    dataMap[modelId] = { modelId, #asset, (const void *) asset, 0xFF }; \
    ASSET_TO_ID(asset, modelId); \
}

#define MODEL_EXTENDED_FROM_DL(modelId, vanillaId, asset, layer) { \
    dataMap[modelId] = { modelId, #asset, (const void *) asset, layer }; \
    ASSET_TO_ID(asset, modelId); \
}

#define MODEL_EXTENDED_FROM_LVL(asset) { \
    dataMap[(enum ModelExtendedId) lvlGeoIndex] = { (enum ModelExtendedId) lvlGeoIndex, #asset, (const void *) asset, 0xFF }; \
    ASSET_TO_ID(asset, (enum ModelExtendedId) lvlGeoIndex); \
    lvlGeoIndex++; \
}

